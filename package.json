	"scripts": {
		"build": "node bin/fetch-data.js && gulp build && nuxt build",
		"heroku-postbuild": "echo \"$SOURCE_VERSION\" > sha.txt",
		"lint": "npm run lint:css && npm run lint:js",
		"lint:fix": "npm run lint:css:fix && npm run lint:js:fix",
		"lint:css": "stylelint --config .stylelintrc \"./{app,src}/**/*.{css,less,vue}\"",
		"lint:css:fix": "stylelint --fix --config .stylelintrc \"./{app,src}/**/*.{css,less,vue}\"",
		"lint:js": "eslint --cache .",
		"lint:js:fix": "eslint --cache --fix .",
		"prepare": "node bin/fetch-data.js; husky",
		"start": "cross-env NODE_ENV=development gulp",
		"test": "npm run lint && npm run test:e2e",
		"test:e2e": "npm run build && npm run test:e2e:run",
		"test:e2e:run": "NODE_ENV=test npx playwright test"
	},
	"lint-staged": {
		"*.{css,less,vue}": "stylelint --fix",
		"*.{html,js,json,ts,vue}": "eslint --cache --fix"
